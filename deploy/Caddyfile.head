# Demo-Hosting: jede Site liegt unter max-utils.com/demo/<id>/ hinter Basic-Auth (User "demo").
# Wird von deploy/sync.sh zur Caddyfile ergaenzt (eine import-Zeile je Site aus sites.tsv).
{
	admin off
	auto_https off
}

(site) {
	@site_{args[0]} path /demo/{args[0]} /demo/{args[0]}/*
	handle @site_{args[0]} {
		basic_auth {
			demo {args[2]}
		}
		header X-Robots-Tag "noindex, nofollow"
		redir /demo/{args[0]} /demo/{args[0]}/ 308
		handle_path /demo/{args[0]}/* {
			root * /srv/{args[1]}
			file_server
		}
	}
}

